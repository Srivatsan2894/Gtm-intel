# Supabase — get from supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend — get from resend.com (free: 3k emails/month)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=digest@yourdomain.com

# Vercel Cron security — any random string you generate
CRON_SECRET=your-random-secret-here

# App URL — your Vercel deployment URL
NEXT_PUBLIC_APP_URL=https://gtm-intel.vercel.app
